{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec oxlint*)",
      "Bash(pnpm exec oxfmt*)",
      "Bash(pnpm test*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git log*)",
      "Bash(supabase *)",
      "Read(./.env.local)",
      "Write(./.env.local)",
      "Edit(./.env.local)"
    ],
    "ask": ["Bash(git commit*)", "Bash(git push*)", "Bash(git merge*)"],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(npm i*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm add*)",
      "Bash(yarn*)",
      "Bash(rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/run-lint-format.sh"
          }
        ]
      }
    ]
  }
}
