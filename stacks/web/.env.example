# Supabase — get these at: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER prefix this one with NEXT_PUBLIC_ — this key must never reach the browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — get these at: Stripe Dashboard > Developers > API keys (use the TEST keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
