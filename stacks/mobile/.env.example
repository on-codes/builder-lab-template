# Supabase — get these at: Supabase Dashboard > Project Settings > API
# In Expo, these variables need the EXPO_PUBLIC_ prefix to reach the app.
# The service_role key NEVER goes into the mobile bundle — it is only used in Supabase Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — the secret key never goes into the app; it lives only in an Edge Function/backend.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
