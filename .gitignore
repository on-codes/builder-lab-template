node_modules/
.pnp
.pnp.js
.pnpm-store/
package-lock.json
yarn.lock

# Env — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo
.next-profiles/

# Testing
coverage/
playwright-report/
test-results/
/blob-report/

# React Email preview
.react-email/

# Misc
.DS_Store
*.pem
*.log
npm-debug.log*
pnpm-debug.log*
.turbo/

# Supabase local
supabase/.branches
supabase/.temp

# Local tooling state — machine-specific, never committed
.claude/settings.local.json
.claude-flow/
